# Copie para .env se quiser guardar seus valores localmente. As functions
# publicadas NAO leem este arquivo: os valores reais ficam nos segredos do
# InsForge (npx @insforge/cli secrets add CHAVE VALOR). Referencia completa:
# docs/CONFIGURACAO.md

INSFORGE_BASE_URL=https://seu-projeto.insforge.app
INSFORGE_API_KEY=sua-api-key-do-servidor
TELEGRAM_BOT_TOKEN=123456789:token-do-bot-telegram
TELEGRAM_WEBHOOK_SECRET=gere-um-segredo-longo-e-aleatorio
TELEGRAM_ALLOWED_CHAT_ID=123456789
DASHBOARD_READ_TOKEN=gere-um-token-longo-e-aleatorio
DASHBOARD_TOGGLE_TOKEN=gere-outro-token-longo-e-aleatorio
# Nome de fuso horario IANA. Padrao: America/Sao_Paulo (horario de Brasilia).
DASHBOARD_TIMEZONE=America/Sao_Paulo

# Resumo diario (/resumo, /resumo_hora): autentica o disparo de hora em hora
# (veja scripts/schedule-daily-digest.mjs); nunca e usado pelo Telegram.
# O resumo fecha o dia na hora local configurada com /resumo_hora (padrao 22h).
DAILY_DIGEST_TOKEN=gere-um-token-longo-e-aleatorio

# Linguagem natural (mensagens de texto livre e audio) — qualquer endpoint
# compativel com OpenAI. O padrao e a camada de compatibilidade do Gemini.
# Sem LLM_API_KEY, o webhook usa um interpretador de regras (sem IA).
#
# A escolha do modelo e questao de cota: no plano gratuito do Gemini os
# modelos flash completos permitem so ~20 requisicoes por dia; os flash-lite
# permitem bem mais. Veja seus limites em https://ai.dev/rate-limit.
#
# LLM_REASONING_EFFORT=low mantem as respostas em ~1s: por padrao o Gemini 3.x
# "pensa" antes de responder, o que custa 9-13s numa tarefa tao pequena.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=opcional-para-linguagem-natural
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
# So para mensagens de voz. E derivado de LLM_BASE_URL quando ela aponta para
# o Gemini (a camada compativel com OpenAI rejeita OGG/Opus, o endpoint nativo
# aceita). Defina para sobrescrever, ou ignore com outro provedor.
# LLM_AUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Clima (Open-Meteo — publico, sem chave, uma localizacao fixa)
WEATHER_LAT=-23.5505
WEATHER_LON=-46.6333

# Agenda (opcional — qualquer servidor CalDAV, ex.: Nextcloud, Radicale, Home Assistant)
CALDAV_BASE_URL=https://seu-servidor-caldav
CALDAV_CALENDAR_PATH=/calendars/usuario/pessoal/
CALDAV_USERNAME=seu-usuario-caldav
CALDAV_PASSWORD=sua-senha-ou-senha-de-app
# A agenda mostra os proximos AGENDA_MAX_EVENTS eventos, seja qual for a data.
# O horizonte so limita a consulta CalDAV e a expansao de recorrencias — nao e
# um filtro de "mostrar eventos dos proximos N dias". Diminuir esconde eventos.
AGENDA_LOOKAHEAD_DAYS=365
AGENDA_MAX_EVENTS=6

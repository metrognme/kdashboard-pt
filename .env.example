INSFORGE_BASE_URL=https://your-project.insforge.app
INSFORGE_API_KEY=your-server-only-api-key
TELEGRAM_BOT_TOKEN=123456789:telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
TELEGRAM_ALLOWED_CHAT_ID=123456789
DASHBOARD_READ_TOKEN=generate-a-long-random-read-token
DASHBOARD_TOGGLE_TOKEN=generate-a-long-random-toggle-token
# IANA time zone name. Without it the backend runs on UTC.
DASHBOARD_TIMEZONE=America/Sao_Paulo

# Daily digest (/resumo, /resumo_hora): authenticates the hourly schedule tick
# (see scripts/schedule-daily-digest.mjs), never used by the Telegram side.
# The digest closes the day at DASHBOARD_TIMEZONE's local hour configured via
# /resumo_hora (default 22h) — nothing here controls that hour, only the tick.
DAILY_DIGEST_TOKEN=generate-a-long-random-token

# NLP (Telegram message parsing) — any OpenAI-compatible endpoint. The default
# is Gemini's compatibility layer. Without LLM_API_KEY set, the webhook falls
# back to a deterministic heuristic parser (no LLM call).
#
# Model choice is mostly a quota decision: on Gemini's free tier the full
# flash models allow only ~20 requests per day, while the flash-lite models
# allow far more. Check your own limits at https://ai.dev/rate-limit.
#
# LLM_REASONING_EFFORT=low is what keeps replies at ~1s: Gemini 3.x thinks
# before answering by default, which costs 9-13s on a task this small.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=optional-for-natural-language-agent
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
# Voice notes only. Derived from LLM_BASE_URL when it points at Gemini (the
# OpenAI-compatible layer rejects OGG/Opus, the native endpoint accepts it);
# set this to override, or ignore it entirely with another provider.
# LLM_AUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Weather (Open-Meteo — public, no API key required, fixed single location)
WEATHER_LAT=-23.5505
WEATHER_LON=-46.6333

# Agenda (optional — any CalDAV server, e.g. Nextcloud, Radicale, Home Assistant)
CALDAV_BASE_URL=https://your-caldav-host
CALDAV_CALENDAR_PATH=/calendars/user/personal/
CALDAV_USERNAME=your-caldav-username
CALDAV_PASSWORD=your-caldav-password-or-app-token
# The agenda shows the next AGENDA_MAX_EVENTS events whatever their date, so
# the lookahead only bounds the CalDAV query and the recurrence walk — it is
# not a "show events within N days" filter. Shrinking it hides events.
AGENDA_LOOKAHEAD_DAYS=365
AGENDA_MAX_EVENTS=6

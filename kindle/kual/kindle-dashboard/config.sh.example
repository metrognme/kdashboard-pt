# Copie este arquivo para config.sh dentro da extensao KUAL instalada
# (extensions/kindle-dashboard/config.sh) e troque as URLs e tokens pelos do
# seu projeto InsForge. Guia completo: docs/CONFIGURACAO.md

DASHBOARD_DATA_URL="https://seu-projeto.insforge.app/functions/kindle-dashboard-data"
DASHBOARD_EVENTS_URL="https://seu-projeto.function2.insforge.app/kindle-dashboard-events"
DASHBOARD_TOGGLE_URL="https://seu-projeto.insforge.app/functions/kindle-dashboard-toggle"
DASHBOARD_READ_TOKEN="troque-pelo-seu-read-token"
DASHBOARD_TOGGLE_TOKEN="troque-pelo-seu-toggle-token"

# Texto do cabecalho (aparece em maiusculas, sem acentos). Coloque seu nome,
# o da sua familia, ou o que quiser.
DASHBOARD_TITLE="Painel Kindle"

# De quanto em quanto tempo o Kindle busca atualizacoes no backend, em
# segundos. 180 = 3 minutos. Quanto MENOR o numero, mais rapido as mudancas
# aparecem e MAIS BATERIA o Kindle gasta (Wi-Fi e tela trabalham mais vezes).
# Sugestoes: 60 (1 min, gasta mais), 180 (padrao), 600 (10 min), 1800 (30 min,
# gasta menos).
INTERVAL="180"

# Atualizacao instantanea (SSE): 1 = as mudancas aparecem em segundos, mas o
# Kindle fica conectado ao servidor o tempo todo e a bateria dura BEM menos.
# 0 (padrao) = o Kindle so busca novidades a cada INTERVAL.
# So funciona com DASHBOARD_EVENTS_URL preenchida.
DASHBOARD_LIVE_UPDATES="0"

# Outros padroes. So mude se souber o que quer.
# 1 = impede o Kindle de dormir enquanto o painel roda.
DASHBOARD_KEEP_AWAKE="1"
# "off" ou uma janela noturna sem atualizacoes, ex.: "23:00-07:00".
DASHBOARD_SLEEP_WINDOW="off"
# Opcional: deixe comentado para usar o fuso do proprio Kindle.
# DASHBOARD_TIMEZONE="America/Sao_Paulo"
# Modo escuro: 1 desenha o painel inteiro em branco sobre preto. As opcoes
# "(escuro)" do menu do KUAL forcam o modo escuro naquela execucao.
DARK_MODE="0"
